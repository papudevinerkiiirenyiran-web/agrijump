# ============================================================
#  AgriJump — shared board credentials
# ------------------------------------------------------------
#  Copy this file to  .env.local  and fill in the two values.
#
#  Where to find them:
#    Supabase dashboard → your project
#    → Project Settings (gear icon) → API
#      · Project URL      → NEXT_PUBLIC_SUPABASE_URL
#      · anon public key  → NEXT_PUBLIC_SUPABASE_ANON_KEY
#
#  The "anon public" key is SAFE to ship in a web app — it is
#  meant to be visible in the browser. Row level security in the
#  database is what actually protects your data.
#
#  NEVER paste the "service_role" key here. That one bypasses all
#  security and must stay secret.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
